{
  "manifest_version": 3,
  "name": "搜索聚合",
  "version": "1.0.0",
  "description": "右键选中文字，一键在百度、谷歌、Bilibili、抖音或自定义搜索引擎中搜索。",
  "permissions": ["contextMenus", "storage"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "搜索聚合：设置",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
